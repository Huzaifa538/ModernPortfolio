# Copy to .env and fill in your own values:  cp .env.example .env

# --- Server ---
PORT=5000

# --- Database ---
USE_IN_MEMORY_DB=true
MONGO_URI=mongodb://127.0.0.1:27017/modern-portfolio

# --- Auth ---
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-64-char-hex-string

# --- Frontend ---
CLIENT_URL=http://localhost:5173

# --- Seed admin user ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-going-live
